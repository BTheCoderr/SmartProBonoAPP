# AI Development Rig Configuration for SmartProBono
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here
MODEL_NAME=claude-3-5-sonnet-20240620

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=BTheCoderr/SmartProBonoAPP
GIT_AUTHOR_NAME=SmartProBono-AI
GIT_AUTHOR_EMAIL=ai-bot@smartprobono.dev

# Agent Limits
MAX_TOKENS=4000
AGENT_COST_LIMIT_USD=10
AGENT_TIME_LIMIT_MIN=30

# Security: Only allow changes to these paths
ALLOWLIST_PATHS=frontend/src,frontend/package.json,backend,render.yaml,README.md

# Branch and Issue Configuration
BRANCH_PREFIX=ai/smartprobono
ISSUE_TRIGGER_LABEL=ai-build
