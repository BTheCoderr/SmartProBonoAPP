  "shortcuts": [
    {
      "name": "Voice Chat",
      "short_name": "Chat",
      "description": "Start a voice conversation with AI",
      "url": "/voice-chat",
      "icons": [
        {
          "src": "/icons/chat-96x96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Cases",
      "short_name": "Cases",
      "description": "View your legal cases",
      "url": "/cases",
      "icons": [
        {
          "src": "/icons/cases-96x96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Documents",
      "short_name": "Docs",
      "description": "Access your documents",
      "url": "/documents",
      "icons": [
        {
          "src": "/icons/docs-96x96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.smartprobono.mobile",
      "id": "com.smartprobono.mobile"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/smartprobono/id123456789"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "file_handlers": [
    {
      "action": "/documents/upload",
      "accept": {
        "application/pdf": [".pdf"],
        "application/msword": [".doc"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "text/plain": [".txt"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+smartprobono",
      "url": "/case?id=%s"
    }
  ]
}
